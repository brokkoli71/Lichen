# Copy to secrets.yaml (gitignored) and fill in. Never commit the real file.
wifi_ssid: "your ssid"
wifi_password: "your password"
# Hotspot the board opens when it can't reach the network above
fallback_password: "at least 8 characters"
# 32 random bytes, base64 -- generate with: openssl rand -base64 32
# Home Assistant asks for it when adopting the device
api_encryption_key: "replace-me"
# Required for over-the-air (Wi-Fi) firmware updates
ota_password: "replace-me"
